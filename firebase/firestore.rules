rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isGroupMember(groupId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Single-document lookup by exact inviteId only (prevents brute-force listing)
    match /inviteIndex/{inviteId} {
      allow get: if signedIn();
      allow list: if false;
      allow write: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /groups/{groupId} {
      allow read, update: if isGroupMember(groupId);
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberIds;

      match /memberSettings/{uid} {
        allow read, write: if isGroupMember(groupId) && request.auth.uid == uid;
      }

      match /messages/{messageId} {
        allow read, create: if isGroupMember(groupId);
        allow update: if isGroupMember(groupId) && (
          resource.data.senderId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['readBy', 'reactions', 'poll', 'viewedOnceBy'])
        );
        allow delete: if isGroupMember(groupId) && resource.data.senderId == request.auth.uid;
      }
    }

    match /scheduledMessages/{jobId} {
      allow create: if signedIn() && request.resource.data.payload.senderId == request.auth.uid;
      allow read, delete: if signedIn() && resource.data.payload.senderId == request.auth.uid;
    }

    match /calls/{callId} {
      allow create: if isGroupMember(request.resource.data.groupId);
      allow read, update: if isGroupMember(resource.data.groupId);
    }
  }
}
